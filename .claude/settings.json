{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(bash *)",
      "Bash(sh)",
      "Bash(sh *)",
      "Bash(zsh *)",
      "Bash(nohup *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(node *)",
      "Bash(node -e *)",
      "Bash(node)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(perl *)",
      "Bash(ruby *)",
      "Bash(osascript *)",
      "Bash(deno *)",
      "Bash(deno)",
      "Bash(bun *)",
      "Bash(bun)",
      "Bash(bunx *)",
      "Bash(tsx *)",
      "Bash(ts-node *)",
      "Bash(php *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(chmod *)",
      "Bash(env *)",
      "Bash(/usr/bin/env *)",
      "Bash(brew install *)",
      "Bash(brew upgrade *)",
      "Bash(brew uninstall *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --recursive *)",
      "Bash(find * -delete*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)"
    ],
    "allow": [
      "Bash(jq:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(file:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(tim:*)",
      "Bash(gh api user:*)",
      "Bash(gh pr view:*)",
      "Bash(npm --prefix tim:*)",
      "Bash(git -C repos/trade-imports-animals-frontend:*)",
      "Bash(npm --prefix repos/trade-imports-animals-frontend:*)",
      "Bash(git -C repos/trade-imports-animals-backend:*)",
      "Bash(mvn -f repos/trade-imports-animals-backend/pom.xml:*)",
      "Bash(git -C repos/trade-imports-animals-admin:*)",
      "Bash(npm --prefix repos/trade-imports-animals-admin:*)",
      "Bash(git -C repos/trade-imports-stub:*)",
      "Bash(mvn -f repos/trade-imports-stub/pom.xml:*)",
      "Bash(git -C repos/trade-imports-reference-data:*)",
      "Bash(mvn -f repos/trade-imports-reference-data/pom.xml:*)",
      "Bash(git -C repos/trade-imports-defra-id-stub:*)",
      "Bash(npm --prefix repos/trade-imports-defra-id-stub:*)",
      "Bash(git -C repos/trade-imports-dynamics-gateway:*)",
      "Bash(mvn -f repos/trade-imports-dynamics-gateway/pom.xml:*)",
      "Bash(git -C repos/trade-imports-address-book:*)",
      "Bash(mvn -f repos/trade-imports-address-book/pom.xml:*)",
      "Bash(git -C repos/trade-imports-ins-frontend:*)",
      "Bash(npm --prefix repos/trade-imports-ins-frontend:*)",
      "Bash(git -C repos/trade-imports-routing-proxy:*)",
      "Bash(npm --prefix repos/trade-imports-routing-proxy:*)",
      "Bash(git -C repos/trade-imports-ins-backend:*)",
      "Bash(mvn -f repos/trade-imports-ins-backend/pom.xml:*)",
      "Bash(git -C repos/trade-imports-ins-tests:*)",
      "Bash(npm --prefix repos/trade-imports-ins-tests:*)",
      "Bash(git -C repos/trade-imports-plants-frontend:*)",
      "Bash(npm --prefix repos/trade-imports-plants-frontend:*)",
      "Bash(git -C repos/trade-imports-plants-prototype:*)",
      "Bash(npm --prefix repos/trade-imports-plants-prototype:*)",
      "Bash(git -C repos/trade-imports-plants-backend:*)",
      "Bash(mvn -f repos/trade-imports-plants-backend/pom.xml:*)",
      "Bash(git -C repos/trade-imports-performance-tests:*)",
      "Bash(npm --prefix repos/trade-imports-performance-tests:*)",
      "Bash(git -C repos/trade-imports-schemas:*)",
      "Bash(npm --prefix repos/trade-imports-schemas:*)",
      "Bash(git:*)",
      "Bash(find repos/*)",
      "Bash(find workareas/*)",
      "Bash(find tools/*)",
      "Bash(find docs/*)",
      "Bash(find .claude/*)",
      "Bash(find openspec/*)",
      "Bash(find tim/*)",
      "Bash(awk * repos/*)",
      "Bash(awk * workareas/*)",
      "Bash(awk * tools/*)",
      "Bash(awk * docs/*)",
      "Bash(awk * .claude/*)",
      "Bash(awk * openspec/*)",
      "Bash(awk * tim/*)",
      "Bash(sed * repos/*)",
      "Bash(sed * workareas/*)",
      "Bash(sed * tools/*)",
      "Bash(sed * docs/*)",
      "Bash(sed * .claude/*)",
      "Bash(sed * openspec/*)",
      "Bash(sed * tim/*)"
    ]
  },
  "enabledMcpjsonServers": [
    "sonar-address-book",
    "sonar-admin",
    "sonar-backend",
    "sonar-frontend",
    "sonar-gateway",
    "sonar-ins-backend",
    "sonar-ins-frontend",
    "sonar-reference-data"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "W=\"$CLAUDE_PROJECT_DIR\"; if [ -f \"$W/tim/src/cli.js\" ] && [ -d \"$W/tim/node_modules\" ]; then node \"$W/tim/src/cli.js\" sonar push-check --hook; fi",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edits.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v sonar >/dev/null 2>&1; then sonar hook claude-pre-tool-use; fi",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "TIM_NO_AUTO_PULL=1 node \"$CLAUDE_PROJECT_DIR/tim/src/cli.js\" --workspace \"$CLAUDE_PROJECT_DIR\" sonar pending record 2>/dev/null || true",
            "if": "Bash(git push*)",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v sonar >/dev/null 2>&1; then sonar hook claude-prompt-submit; fi",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "TIM_NO_AUTO_PULL=1 node \"$CLAUDE_PROJECT_DIR/tim/src/cli.js\" --workspace \"$CLAUDE_PROJECT_DIR\" sonar pending check --event UserPromptSubmit 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TIM_NO_AUTO_PULL=1 node \"$CLAUDE_PROJECT_DIR/tim/src/cli.js\" --workspace \"$CLAUDE_PROJECT_DIR\" sonar pending check --event SessionStart 2>/dev/null || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "TIM_NO_AUTO_PULL=1 node \"$CLAUDE_PROJECT_DIR/tim/src/cli.js\" --workspace \"$CLAUDE_PROJECT_DIR\" sonar mcp-tidy 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false
}
