{
  "title": "<service> (custom)",
  "tags": [
    "<service>",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "cloudwatch",
        "label": "CloudWatch",
        "query": "cloudwatch",
        "hide": 0
      },
      {
        "type": "datasource",
        "name": "opensearch",
        "label": "OpenSearch",
        "query": "grafana-opensearch-datasource",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Dependency status",
      "description": "external.dependency.available, Minimum: 1 available, 0 not. Fresh for a database (driver heartbeats) or an active probe; for a passive HTTP reading it is the last call's outcome, however old.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "external.dependency.available",
          "statistic": "Minimum",
          "dimensions": {
            "dependency": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.dependency')}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Available",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "<dependency>",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Calls",
      "description": "external.call.duration, SampleCount, for <dependency>, per operation.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "external.call.duration",
          "statistic": "SampleCount",
          "dimensions": {
            "dependency": "<dependency>",
            "operation": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.operation')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Failed calls",
      "description": "external.call.failure, Sum, for <dependency>, per operation.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "external.call.failure",
          "statistic": "Sum",
          "dimensions": {
            "dependency": "<dependency>",
            "operation": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.operation')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Failure rate",
      "description": "external.call.failure, Average (each call publishes 0 or 1), shown as a percentage, for <dependency>, per operation.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "external.call.failure",
          "statistic": "Average",
          "dimensions": {
            "dependency": "<dependency>",
            "operation": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.operation')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Call time",
      "description": "external.call.duration: Average, p95 and Maximum, for <dependency>, per operation.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "external.call.duration",
          "statistic": "Average",
          "dimensions": {
            "dependency": "<dependency>",
            "operation": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.operation')} average"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "external.call.duration",
          "statistic": "p95",
          "dimensions": {
            "dependency": "<dependency>",
            "operation": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.operation')} p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "external.call.duration",
          "statistic": "Maximum",
          "dimensions": {
            "dependency": "<dependency>",
            "operation": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.operation')} slowest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Caches",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Cache hits and misses",
      "description": "cache.hit and cache.miss, Sum, per cache.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "cache.hit",
          "statistic": "Sum",
          "dimensions": {
            "cache": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.cache')} hits"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "cache.miss",
          "statistic": "Sum",
          "dimensions": {
            "cache": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.cache')} misses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Business events",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "<business-metric> by <business-dimension>",
      "description": "<business-metric>, Sum, per <business-dimension>.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "<business-metric>",
          "statistic": "Sum",
          "dimensions": {
            "<business-dimension>": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "${PROP('Dim.<business-dimension>')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Dependency call logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Slowest dependency calls",
      "description": "From the logs, not metrics: one row per external call, slowest first. event.action is the dependency and operation, as dependency/operation; event.duration is a number in nanoseconds. Lucene query, not DQL.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${opensearch}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "${opensearch}"
          },
          "queryType": "lucene",
          "query": "event.category:\"external-call\" AND service.name:\"<service>\"",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "500"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "@timestamp": true,
              "event.action": true,
              "event.outcome": true,
              "event.duration": true,
              "trace.id": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "event.duration",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "event.duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "Timers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "<timed-name>",
      "description": "@Timed(\"<timed-name>\"), published by EmfMeterRegistry: one value per call, in milliseconds, with the timer's tags (class, method, exception) as dimensions. Calls is SampleCount; Average, p95 and Slowest are over the calls in each period.",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "<timed-name>",
          "statistic": "Average",
          "dimensions": {
            "class": "*",
            "method": "*",
            "exception": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "Average ${PROP('Dim.exception')}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "<timed-name>",
          "statistic": "p95",
          "dimensions": {
            "class": "*",
            "method": "*",
            "exception": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "p95 ${PROP('Dim.exception')}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "<timed-name>",
          "statistic": "Maximum",
          "dimensions": {
            "class": "*",
            "method": "*",
            "exception": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "Slowest ${PROP('Dim.exception')}"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "<service>",
          "metricName": "<timed-name>",
          "statistic": "SampleCount",
          "dimensions": {
            "class": "*",
            "method": "*",
            "exception": "*"
          },
          "matchExact": false,
          "period": "",
          "label": "Calls ${PROP('Dim.exception')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    }
  ]
}
