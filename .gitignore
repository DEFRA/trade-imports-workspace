# macOS
.DS_Store

# IDE
.idea/

# Obsidian (local notes vault + canvas whiteboards)
.obsidian/
*.canvas

# Claude Code local settings (contains personal paths) — but track checked-in skills/agents/project-settings
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json
!.claude/hooks/
!.claude/rules/

# Runtime cache for agent skills (review/style/upgrade workspaces, ticket plans, etc.)
# Use `workareas/*` (not `workareas/`) so git descends into the dir and can
# re-include shared/ below — the dir-form `workareas/` would stop descent.
workareas/*
# Exception: shared/ is the handoff namespace — artifacts committed to handoff branches
!workareas/shared/

# Exception: a build-loop backlog.json is canonical state, not cache — it is the
# executable definition of a body of work and survives the run that produced it.
# Everything else under a run directory (logs, scratch, captures) stays ignored.
!workareas/journey-builder/
workareas/journey-builder/*
!workareas/journey-builder/*/
workareas/journey-builder/*/*
!workareas/journey-builder/*/backlog.json
# Deferred work: prototype-side leads a corpus refresh turned up that are not
# verified to backlog standard and are not being worked yet. Tracked for the
# same reason the backlog is — they outlive the conversation that found them.
!workareas/journey-builder/*/deferred.json

# Agent AI memory (local only)
agents/memory/

# Local-only scripts (personal, never committed)
tools/review/prepare-ac-check.sh

# Cloned repos — run `make setup` to populate. Leading slash anchors this to
# the workspace root so it cannot swallow docs/repos/ (per-repo notes).
/repos/

# Init scripts staged from owning repos by scripts/stack — never commit
docker/stack/.staged/

# SonarCloud push-check hook state (pending/seen markers, runtime only)
.sonar-checks/

# Synced Confluence docs (generated, not committed)
docs/confluence/

# Symlink to local cdp-documentation repo
docs/cdp

# Playwright report + traces pulled from the ipaffs-qa-automation Jenkins job (multi-GB, local only)
ipaffs-playwright-traces/

# direnv files (personal Atlassian credential mapping — never commit)
.env
.envrc

# Node dependencies — every repo and sub-project installs its own
node_modules/

# Scratch output from agent runs and local test invocations. These accumulate
# in workareas/shared/, which is otherwise tracked, and drown real handover
# docs in `git status`.
*.log

# Test and browser tooling output
allure-results/
allure-report/
.playwright-cli/
.playwright-mcp/
playwright-report/
test-results/
