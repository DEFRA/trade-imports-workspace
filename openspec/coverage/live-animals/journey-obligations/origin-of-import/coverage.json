{
  "capability": "live-animals/journey-obligations/origin-of-import",
  "areaCode": "OB-ORIGIN",
  "specFile": "openspec/specs/live-animals/journey-obligations/origin-of-import/spec.md",
  "requirements": [
    {
      "id": "REQ-OB-ORIGIN-001",
      "name": "Whether a region of origin code is required decides whether the code is mandatory, not whether it is asked for",
      "coverage": "full",
      "scenarios": [
        {
          "id": "SCN-OB-ORIGIN-001-A",
          "name": "Answering that a region code is required makes it mandatory",
          "coverage": "full",
          "tests": [
            { "type": "fit", "repo": "trade-imports-animals-frontend", "file": "src/server/app/sets/live-animals/journeys/linear/features/origin/origin.fit.spec.js", "test": "region code validation: when Yes is chosen and the box is empty, holds the user on the page", "strength": "full", "notes": "" },
            { "type": "unit", "repo": "trade-imports-animals-frontend", "file": "src/server/app/sets/live-animals/journeys/linear/features/origin/controller.test.js", "test": "Should hold the user on the page when the typed part is blank", "strength": "full", "notes": "" },
            { "type": "unit", "repo": "trade-imports-animals-frontend", "file": "src/server/app/sets/live-animals/journeys/linear/features/origin/controller.test.js", "test": "Should hold the user on the page when the box was never submitted", "strength": "full", "notes": "" }
          ]
        },
        {
          "id": "SCN-OB-ORIGIN-001-B",
          "name": "Answering that no region code is required leaves it optional",
          "coverage": "full",
          "tests": [
            { "type": "fit", "repo": "trade-imports-animals-frontend", "file": "src/server/app/sets/live-animals/journeys/linear/features/origin/origin.fit.spec.js", "test": "region code validation: No leaves the empty box unasked for", "strength": "full", "notes": "" },
            { "type": "unit", "repo": "trade-imports-animals-frontend", "file": "src/server/app/sets/live-animals/journeys/linear/features/origin/controller.test.js", "test": "Should let a blank box through when the answer is No", "strength": "full", "notes": "" }
          ]
        }
      ]
    },
    {
      "id": "REQ-OB-ORIGIN-002",
      "name": "Answering that no region code is required clears a code already given",
      "coverage": "full",
      "scenarios": [
        {
          "id": "SCN-OB-ORIGIN-002-A",
          "name": "The code is cleared when the answer changes to No",
          "coverage": "full",
          "tests": [
            { "type": "fit", "repo": "trade-imports-animals-frontend", "file": "src/server/app/sets/live-animals/journeys/linear/features/origin/origin.fit.spec.js", "test": "answering No clears a saved region code: the review shows Not applicable and Yes shows an empty box", "strength": "full", "notes": "" },
            { "type": "unit", "repo": "trade-imports-animals-frontend", "file": "src/server/app/sets/live-animals/journeys/linear/features/origin/controller.test.js", "test": "Should clear the stored code when the answer changes from Yes to No", "strength": "full", "notes": "" },
            { "type": "unit", "repo": "trade-imports-animals-frontend", "file": "src/server/app/sets/live-animals/journeys/linear/features/origin/controller.test.js", "test": "Should show an empty box when Yes is chosen again after No", "strength": "full", "notes": "" },
            { "type": "e2e", "repo": "trade-imports-ins-tests", "file": "tests/animals/e2e/pages/origin.spec.ts", "test": "answering No clears a saved region of origin code", "strength": "full", "notes": "" }
          ]
        }
      ]
    }
  ]
}
