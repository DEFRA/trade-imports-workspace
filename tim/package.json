{
  "name": "tim",
  "version": "0.0.0",
  "description": "Trade Imports CLI — Node.js Ink/React TUI for the trade-imports workspace",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "tim": "./src/launcher.js"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,md,json,config.js,test.js}\"",
    "tim": "node src/cli.js",
    "test": "TZ=UTC vitest run",
    "test:ci": "TZ=UTC vitest run --coverage --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "test:watch": "TZ=UTC vitest",
    "test:workspace-paths": "npm run test -- src/skill-workflows/workspace-paths.test.js",
    "coverage": "TZ=UTC vitest run --coverage"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@playwright/test": "1.65.0",
    "ajv": "^8.20.0",
    "commander": "^15.1.0",
    "ink": "^7.0.5",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.2.0",
    "jscpd": "5.4.3",
    "npm-check-updates": "23.1.1",
    "picomatch": "^4.0.4",
    "pino": "^10.4.0",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "semver": "7.8.6",
    "undici": "^8.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "acorn": "^8.19.0",
    "eslint": "^10.15.0",
    "execa": "^9.6.1",
    "ink-testing-library": "^4.0.0",
    "neostandard": "^0.14.1",
    "nock": "^14.0.15",
    "prettier": "^3.10.1",
    "vitest": "^5.1.0"
  }
}
