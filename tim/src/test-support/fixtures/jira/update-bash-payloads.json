{
  "summary": {
    "args": ["-s", "New summary"],
    "put": {
      "fields": {
        "summary": "New summary"
      }
    }
  },
  "description": {
    "args": ["-d", "New description"],
    "put": {
      "fields": {
        "description": "New description"
      }
    }
  },
  "priority": {
    "args": ["-P", "High"],
    "put": {
      "fields": {
        "priority": {
          "name": "High"
        }
      }
    }
  },
  "parent": {
    "args": ["-p", "EUDPA-215"],
    "put": {
      "fields": {
        "parent": {
          "key": "EUDPA-215"
        }
      }
    }
  },
  "parentNone": {
    "args": ["-p", "none"],
    "put": {
      "fields": {
        "parent": null
      }
    }
  },
  "labels": {
    "args": ["-l", "alpha,beta"],
    "put": {
      "fields": {
        "labels": ["alpha", "beta"]
      }
    }
  },
  "addLabel": {
    "args": ["--add-label", "urgent", "--add-label", "existing-b"],
    "put": {
      "fields": {
        "labels": ["existing-a", "existing-b", "urgent"]
      }
    }
  },
  "labelsAndAddLabel": {
    "args": ["-l", "alpha", "--add-label", "urgent"],
    "put": {
      "fields": {
        "labels": ["alpha"]
      }
    }
  }
