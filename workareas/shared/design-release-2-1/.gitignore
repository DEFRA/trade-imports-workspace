# Trace corpora and recordings run to hundreds of megabytes. Their reports and
# indexes stay tracked; regenerate the binaries with sources/REAL-RUNS.md and
# prototype-specs/README.md.
sources/traces-*/*/
sources/traces-*/*.zip
evidence/**/*.png
prototype-specs/test-results/
prototype-specs/playwright-report/
prototype-specs/node_modules/
distil/extract/*.work/
combined/**/*.png
combined/**/node_modules/
combined/**/test-results/

# Text stays in git; pixels, recordings and run output do not. Screenshots and
# traces are regenerated from the specs that captured them.
*.png
*.jpg
*.jpeg
*.webm
*.zip
themes/*/logs/
.tmp/
layers/
