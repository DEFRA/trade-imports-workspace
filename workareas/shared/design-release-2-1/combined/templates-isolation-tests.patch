diff --git a/README.md b/README.md
index 810807d..c51a924 100644
--- a/README.md
+++ b/README.md
@@ -182,6 +182,15 @@ holds only the `sid` auth cookie, and is never written unless a fresh context
 has proved it restores to a signed-in landing page. A spec that must start
 unauthenticated opts out with `test.use({ storageState: COLD_START })`.
 
+Every worker signs in as Andrew, the shared default user, unless its spec sets
+`test.use({ isolatedUser: true })`. A spec does that when it asserts the order
+or count of the signed-in user's own records, such as which template is listed
+first: its workers then sign in as the defra-id-stub's "Isolated User NN" for
+their parallel slot, so no other running worker writes to that user. The stub
+holds 32 of them (`config/users.ts`); a run with more workers fails at the
+first such spec, naming the fix. Records every user can see, such as the
+dashboard's notifications, are not isolated by this.
+
 `E2E_SESSION_REUSE=off` is the kill switch: every test signs in for itself
 again. The CDP config caps workers at 4 when reuse is off; against the
 docker-compose stack re-cap them yourself (e.g. `-- --workers=4`).
diff --git a/config/users.ts b/config/users.ts
index 5dd30e3..70f6163 100644
--- a/config/users.ts
+++ b/config/users.ts
@@ -23,3 +23,42 @@ export const users = {
 export const defaultUser = users.andrew;
 
 export const defaultPassword = process.env.AUTH_PASSWORD || 'Password123';
+
+export type StubUser = { crn: string; displayName: string };
+
+const FIRST_ISOLATED_CRN = 2100010201;
+const ISOLATED_USER_COUNT = 32;
+
+/**
+ * The stub's "Isolated User 01" to "32": single-organisation identities (Gatwick Airport, like Andrew)
+ * that no spec names directly, so a worker signed in as one is the only writer of that user's records.
+ */
+export const isolatedUsers: readonly StubUser[] = Array.from({ length: ISOLATED_USER_COUNT }, (_, index) => {
+  const number = String(index + 1).padStart(2, '0');
+  return { crn: String(FIRST_ISOLATED_CRN + index), displayName: `Isolated User ${number}` };
+});
+
+/**
+ * The isolated user for one parallel worker slot. Playwright gives every worker running at the same
+ * time a different parallelIndex, so no two running workers share the user.
+ */
+export const isolatedUserFor = (parallelIndex: number): StubUser => {
+  const user = isolatedUsers[parallelIndex];
+  if (!user) {
+    throw new Error(
+      `Worker slot ${parallelIndex} has no isolated user: the stub has ${isolatedUsers.length}. ` +
+        'Run fewer workers, or add users to trade-imports-defra-id-stub src/data/mock.json and to isolatedUsers here.',
+    );
+  }
+  return user;
+};
+
+let workerUser: StubUser = defaultUser;
+
+/** The identity this worker process signs in as when a sign-in does not name one. */
+export const signedInUser = (): StubUser => workerUser;
+
+/** Each Playwright worker is its own process, so this sets the identity for this worker's tests only. */
+export const signWorkerInAs = (user: StubUser): void => {
+  workerUser = user;
+};
