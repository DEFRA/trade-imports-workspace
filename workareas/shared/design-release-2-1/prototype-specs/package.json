{
  "name": "design-release-2-1-prototype-specs",
  "private": true,
  "description": "Fit-style Playwright specs that walk every Design Release 2.1 journey of the GB-notification-service prototype",
  "scripts": {
    "test": "node run-suite.js",
    "test:only": "playwright test",
    "test:list": "playwright test --list",
    "report": "playwright show-report playwright-report",
    "serve": "node serve-prototype.js",
    "collect": "node collect-traces.js",
    "coverage": "node gen-coverage.js",
    "explore": "playwright test --config explore/explore.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
