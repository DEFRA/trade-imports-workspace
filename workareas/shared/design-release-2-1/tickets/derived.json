      "scenarios": [
        {
          "heading": "A reference written in one of the shapes real documents carry is taken on",
          "id": "SCN-DOCS-006-F",
          "steps": [
            {
              "keyword": "GIVEN",
              "text": "the user enters a reference written as an air waybill with a hyphen, a certificate with full stops, or an invoice with a space and a forward slash"
            },
            {
              "keyword": "WHEN",
              "text": "they add the document"
            },
            {
              "keyword": "THEN",
              "text": "it is taken on and held against the notification with that reference as typed"
            }
          ],
          "file": "live-animals/journey-pages/upload-documents/spec.md",
          "row": "inc-039",
          "missing": false
        },
        {
          "heading": "A reference carrying a disallowed character is refused",
          "id": "SCN-DOCS-006-G",
          "steps": [
            {
              "keyword": "GIVEN",
              "text": "the user enters a reference carrying a character other than a letter, number, space, hyphen, full stop or forward slash"
            },
            {
              "keyword": "WHEN",
              "text": "they try to add the document"
            },
            {
              "keyword": "THEN",
              "text": "an error reading \"Document reference must only include letters, numbers, spaces, hyphens, full stops and forward slashes\" is shown on the Document reference field"
            },
            {
              "keyword": "AND",
              "text": "no document is added to the notification"
            }
          ],
          "file": "live-animals/journey-pages/upload-documents/spec.md",
          "row": "inc-039",
          "missing": false
        },
        {
          "heading": "Continuing is not blocked while a scan is still running",
          "id": "SCN-DOCS-008-A",
          "steps": [
            {
              "keyword": "GIVEN",
              "text": "a document on the page is still \"Scanning for virus\""
            },
            {
              "keyword": "WHEN",
              "text": "the user tries to continue"
            },
            {
              "keyword": "THEN",
              "text": "continuing takes them onward"
            },
            {
              "keyword": "WHEN",
              "text": "they come back to the page"
            },
            {
              "keyword": "THEN",
              "text": "the document is still listed, and its row settles to \"Check completed\" once the scan finishes"
            }
          ],
          "file": "live-animals/journey-pages/upload-documents/spec.md",
          "row": "inc-038",
          "missing": false
        },
