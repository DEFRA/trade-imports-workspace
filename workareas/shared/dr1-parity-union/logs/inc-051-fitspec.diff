+const partBoxes = (page) => ({
+  county: page.getByLabel(copy.cph.county, { exact: true }),
+  parish: page.getByLabel(copy.cph.parish, { exact: true }),
+  holding: page.getByLabel(copy.cph.holding, { exact: true })
