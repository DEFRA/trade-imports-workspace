-export const meta = { ...page, collects: ['purposeInInternalMarket'] }
-const view = `${TEMPLATES}/features/import-purpose/template`
-
-const copy = copyFor({ en, cy })
-
-const fields = compose(
-  oneOf(
-    'purposeInInternalMarket',
