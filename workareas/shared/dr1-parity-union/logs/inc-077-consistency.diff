+const COUNTRY_ENHANCEMENT_TIMEOUT_MS = 5000
+
+// Country of origin is a type-ahead (accessible-autocomplete) enhancing a
+// native <select>. The enhancement renames the select with a "-select" suffix,
+// so that rename is the signal it has run. A page served without JavaScript
+// never grows one, and the wait running out is that answer, not a failure.
+const countryTypeAheadReady = (page) =>
+  page
+    .locator('select#countryOfOrigin-select')
+    .waitFor({ state: 'attached', timeout: COUNTRY_ENHANCEMENT_TIMEOUT_MS })
+    .then(() => true)
+    .catch(() => false)
+
+// Drive the type-ahead the way a user does: type to filter, then pick the
+// match. Without JavaScript the field stays the select, chosen by its label.
 export const chooseCountryOfOrigin = async (page, name = FIXTURE_COUNTRY) => {
-  await page.getByLabel('Country of origin').selectOption({ label: name })
+  if (!(await countryTypeAheadReady(page))) {
+    await page.locator('select#countryOfOrigin').selectOption({ label: name })
+    return
+  }
+  const field = page.getByLabel('Country of origin', { exact: true })
+  await field.click()
+  await field.fill(name)
+  await page.getByRole('option', { name, exact: true }).click()
 }
 
