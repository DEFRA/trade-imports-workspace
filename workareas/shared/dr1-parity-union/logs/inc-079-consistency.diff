+    configureRecords(recordsStub)
+    configureSession(sessionStub)
+    buildDispatch(dispatchPages)
+  })
+  beforeEach(() => store.clear())
+
+  const postSuffix = (regionOfOriginCodeSuffix) =>
+    driveHandler(post, {
+      payload: {
+        countryOfOrigin: 'FR',
