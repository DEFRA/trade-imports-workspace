@@ -0,0 +1,27 @@
+{% from "govuk/components/table/macro.njk" import govukTable %}
+
+{# The animals already saved against one commodity line: a header row naming
+   every identifier the line declares, then one row per animal keyed by species
+   and number with a cell per identifier and Remove last (design 01-16/17). #}
+{% macro savedAnimalsTable(card, copy) %}
+  {% set head = [{ text: copy.table.animalColumn }] %}
+  {% for label in card.identifierColumns %}
+    {% set ignored = head.push({ text: label }) %}
+  {% endfor %}
+  {% set ignored = head.push({ html: '<span class="govuk-visually-hidden">' + copy.table.actionsHidden + '</span>' }) %}
+
+  {% set rows = [] %}
+  {% for unit in card.units %}
+    {% set removeCell %}
+      <button type="submit" class="govuk-link app-link-button" name="action" value="remove:{{ unit.line }}:{{ unit.unitIndex }}">{{ copy.removeRow }}<span class="govuk-visually-hidden"> {{ unit.removeAria }}</span></button>
+    {% endset %}
+    {% set cells = [{ text: unit.label }] %}
+    {% for cell in unit.cells %}
+      {% set ignored = cells.push({ text: cell }) %}
+    {% endfor %}
+    {% set ignored = cells.push({ html: removeCell, classes: "govuk-!-text-align-right" }) %}
+    {% set ignored = rows.push(cells) %}
+  {% endfor %}
+
+  {{ govukTable({ head: head, rows: rows }) }}
+{% endmacro %}
