+
+// Table cells built as HTML lose Nunjucks' auto-escaping, so anything the
+// trader typed — a document reference, say — is escaped here before it is
+// interpolated into a cell's markup.
+export const escapeHtml = (value) =>
+  value
+    .toString()
+    .replaceAll('&', '&amp;')
+    .replaceAll('<', '&lt;')
+    .replaceAll('>', '&gt;')
+    .replaceAll('"', '&quot;')
+    .replaceAll("'", '&#39;')
