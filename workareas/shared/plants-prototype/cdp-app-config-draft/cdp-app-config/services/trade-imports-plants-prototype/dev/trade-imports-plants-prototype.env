# Config for trade-imports-plants-prototype, settings should be in KEY=value format

# DRAFT for the "dev" environment — the lowest tier trade-imports-plants-frontend
# is configured for in cdp-app-config today (see dev/trade-imports-plants-frontend.env).
# Sam hasn't chosen the prototype's environment yet (PLAN.md, "Open for Sam" #2) —
# change the folder name to match whatever is decided.

# Stub-only: no Redis, backend, reference data, address book or Defra ID.
# STUB_MODE and SESSION_CACHE_ENGINE default to these values in the app itself
# (src/prototype-defaults.js), but only when the variable isn't already set —
# CDP's own production defaults.env sets NODE_ENV=production, which would
# otherwise flip SESSION_CACHE_ENGINE to "redis" (see config.js). Setting both
# explicitly here means the prototype doesn't depend on that local fallback to
# stay in stub mode once it's deployed.
STUB_MODE=true
SESSION_CACHE_ENGINE=memory

# No PORT here. plants-frontend doesn't set one either — CDP's global fixed
# config (global/global_protected_fixed.env) sets PORT=8085 for every service
# and that value can't be overridden. The prototype's own default of 3103
# (src/prototype-defaults.js) only applies to a local, un-configured run; on
# CDP the platform's 8085 always wins, and the app just binds to whatever
# config.port resolves to.

# Deliberately absent, and not from plants-frontend's dev config:
#   TRADE_IMPORTS_ADDRESS_BOOK_URL, TRADE_IMPORTS_PLANTS_BACKEND_URL,
#   TRADE_IMPORTS_REFERENCE_DATA_URL, AUTH_ENABLED, DEFRA_ID_OIDC_CONFIGURATION_URL,
#   DEFRA_ID_CLIENT_ID, DEFRA_ID_SERVICE_ID, DEFRA_ID_POLICY, DEFRA_ID_REDIRECT_URL,
#   DEFRA_ID_SIGN_OUT_REDIRECT_URL, DEFRA_ID_REFRESH_TOKENS
# In stub mode the prototype never calls the real backend, reference data or
# address book services, and never does the real Defra ID OIDC round-trip —
# config.js already has safe stub defaults for all of these, so none need a
# real value here.

# Also not set: TRADE_IMPORTS_INS_FRONTEND_URL. The header's "Address book" link
# and the CSP's form-action origins take it, defaulting to
# http://localhost:3002. The prototype runs no INS frontend, so the link goes
# nowhere either way (a known gap in PROTOTYPE.md). Set it here if the
# prototype should link to a real INS frontend for this environment.
