# Config for trade-imports-plants-prototype, settings should be in KEY=value format

# DRAFT for the "dev" environment — the lowest tier trade-imports-plants-frontend
# is configured for in cdp-app-config today (see dev/trade-imports-plants-frontend.env).
# Sam hasn't chosen the prototype's environment yet (PLAN.md, "Open for Sam" #2) —
# change the folder name to match whatever is decided.

# Sign-in: exactly what plants-frontend does in dev — Defra ID OIDC against the
# workspace's Defra ID stub. Every value but the two redirect URLs is
# plants-frontend's own. The stub keeps no registration list: it accepts any
# client id, service id and redirect URL. The client id picks which set of
# stub users it offers, so reusing plants-frontend's gives the prototype the
# same users.
AUTH_ENABLED=true
DEFRA_ID_OIDC_CONFIGURATION_URL=https://trade-imports-defra-id-stub.dev.cdp-int.defra.cloud/idphub/b2c/b2c_1a_cui_cpdev_signupsigninsfi/.well-known/openid-configuration
DEFRA_ID_CLIENT_ID=600916f0-4baa-4a56-bc24-de07fb99b8bf
DEFRA_ID_SERVICE_ID=a089bcf8-877e-40b8-b53d-b47660a2746e
DEFRA_ID_POLICY=b2c_1a_cui_cpdev_signupsigninsfi
DEFRA_ID_REDIRECT_URL=https://trade-imports-plants-prototype.dev.cdp-int.defra.cloud/auth/sign-in-oidc
DEFRA_ID_SIGN_OUT_REDIRECT_URL=https://trade-imports-plants-prototype.dev.cdp-int.defra.cloud/auth/sign-out-oidc
DEFRA_ID_REFRESH_TOKENS=true

# One instance, no Redis. plants-frontend's production default is Redis, so
# this is set here as well as in src/prototype-defaults.js.
SESSION_CACHE_ENGINE=memory

# No STUB_MODE. In production the prototype ignores it for sign-in, as
# plants-frontend does, and its data services serve stub data regardless
# (isStubDataMode in src/server/common/services/mode.js).

# No PORT. plants-frontend doesn't set one either — CDP's global fixed
# config (global/global_protected_fixed.env) sets PORT=8085 for every service
# and that value can't be overridden.

# Deliberately absent, and in plants-frontend's dev config:
#   TRADE_IMPORTS_ADDRESS_BOOK_URL, TRADE_IMPORTS_PLANTS_BACKEND_URL,
#   TRADE_IMPORTS_REFERENCE_DATA_URL
# The prototype's data is always stubbed, so it never calls those services.

# Also not set: TRADE_IMPORTS_INS_FRONTEND_URL. The header's "Address book" link
# and the CSP's form-action origins take it, defaulting to
# http://localhost:3002. The prototype runs no INS frontend, so the link goes
# nowhere either way (a known gap in PROTOTYPE.md). Set it here if the
# prototype should link to a real INS frontend for this environment.
