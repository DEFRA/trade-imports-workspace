# Config for trade-imports-plants-prototype, settings should be in KEY=value format

# Data is always stubbed in production (isStubDataMode in mode.js), so no backend,
# address book or reference data URLs. Sign-in follows STUB_MODE too, including in
# production (Sam's decision): stub sign-in, the same as a local `npm run dev`, no
# Defra ID stub deployed alongside it. Anyone who reaches this URL is signed in
# automatically until CDP puts its own auth in front, or a later change sets
# STUB_MODE=false to restore plants-frontend's own Defra ID sign-in.
SESSION_CACHE_ENGINE=memory
STUB_MODE=true

# The header's "Address book" link is deliberately dead (Sam's ruling): the
# address book belongs to the Import Notification Service, which this
# prototype does not include. The prototype ignores TRADE_IMPORTS_INS_FRONTEND_URL
# entirely — there is no way to point the link at a real service — so it is
# not set here.
