{"id":"6518997274","type":"page","ari":"ari:cloud:confluence:1786230e-8814-4465-a89e-8dada39293cd:page/6518997274","base64EncodedAri":"YXJpOmNsb3VkOmNvbmZsdWVuY2U6MTc4NjIzMGUtODgxNC00NDY1LWE4OWUtOGRhZGEzOTI5M2NkOmNvbnRlbnQvNjUxODk5NzI3NA==","status":"current","title":"Requirements - National Notification System","space":{"id":6379864103,"ari":"ari:cloud:confluence:1786230e-8814-4465-a89e-8dada39293cd:space/6379864103","key":"EUDP","alias":"EUDP","name":"EUDP Programme","type":"collaboration","status":"current","_expandable":{"settings":"/rest/api/space/EUDP/settings","metadata":"","identifiers":"","roles":"","icon":"","typeSettings":"","description":"","history":"","operations":"","lookAndFeel":"/rest/api/settings/lookandfeel?spaceKey=EUDP","permissions":"","theme":"/rest/api/space/EUDP/theme","homepage":"/rest/api/content/6379864777"},"_links":{"webui":"/spaces/EUDP","self":"https://eaflood.atlassian.net/wiki/rest/api/space/EUDP"}},"history":{"latest":true,"createdBy":{"type":"known","accountId":"712020:8373b4e2-d4e6-4526-b7e9-6f67a8842fd6","accountType":"atlassian","email":"","publicName":"Matt Spooner","profilePicture":{"path":"/wiki/aa-avatar/712020:8373b4e2-d4e6-4526-b7e9-6f67a8842fd6","width":48,"height":48,"isDefault":false},"displayName":"Matt Spooner","isExternalCollaborator":false,"isGuest":false,"locale":"en_US","accountStatus":"active","_expandable":{"operations":"","personalSpace":""},"_links":{"self":"https://eaflood.atlassian.net/wiki/rest/api/user?accountId=712020:8373b4e2-d4e6-4526-b7e9-6f67a8842fd6"}},"createdDate":"2026-05-21T15:51:11.483Z","_expandable":{"lastUpdated":"","previousVersion":"","lastOwnedBy":"","contributors":"","nextVersion":"","ownedBy":""},"_links":{"self":"https://eaflood.atlassian.net/wiki/rest/api/content/6518997274/history"}},"version":{"by":{"type":"known","accountId":"712020:8373b4e2-d4e6-4526-b7e9-6f67a8842fd6","accountType":"atlassian","email":"","publicName":"Matt Spooner","profilePicture":{"path":"/wiki/aa-avatar/712020:8373b4e2-d4e6-4526-b7e9-6f67a8842fd6","width":48,"height":48,"isDefault":false},"displayName":"Matt Spooner","isExternalCollaborator":false,"isGuest":false,"locale":"en_US","accountStatus":"active","_expandable":{"operations":"","personalSpace":""},"_links":{"self":"https://eaflood.atlassian.net/wiki/rest/api/user?accountId=712020:8373b4e2-d4e6-4526-b7e9-6f67a8842fd6"}},"when":"2026-07-02T08:43:28.413Z","friendlyWhen":"02 Jul 2026","message":"","number":5,"minorEdit":false,"ncsStepVersion":"317","ncsStepVersionSource":"ncs-ack","confRev":"confluence$content$6518997274.18","contentTypeModified":false,"_expandable":{"collaborators":"","content":"/rest/api/content/6518997274"},"_links":{"self":"https://eaflood.atlassian.net/wiki/rest/api/content/6518997274/version/5"}},"macroRenderedOutput":{},"body":{"view":{"value":"<h2 local-id=\"ac2a9636412d\" id=\"Requirements-NationalNotificationSystem-Requirementscatalogue\">Requirements catalogue</h2><div class=\"confluence-information-macro confluence-information-macro-information conf-macro output-block\" data-hasbody=\"true\" data-macro-name=\"info\" data-macro-id=\"b54ee083-247c-473a-9cb2-d37128b95e0d\" data-local-id=\"23484c33eb81\"><span class=\"aui-icon aui-icon-small aui-iconfont-info confluence-information-macro-icon\"> </span><div class=\"confluence-information-macro-body\"><p local-id=\"f215d0dff74f\">This page records all requirements logged during exploration, including data requirements, utilising the Requirements Catalogue Excel template, and providing a Sharepoint link to that <a href=\"https://defra.sharepoint.com/:x:/r/teams/Team4068/_layouts/15/Doc.aspx?sourcedoc=%7B3ABC6624-B62B-4AE0-8D6C-A1B065BA3559%7D&amp;file=EU%20Reset%20Delivery%20Programme_Requirements%20Template.xlsx&amp;action=default&amp;mobileredirect=true\" class=\"external-link\" rel=\"nofollow\">here</a>. </p><p local-id=\"a705265bfb85\">This will connect User Needs, Requirements &amp; Data together.</p></div></div><p local-id=\"ff5f6179e33f\">Live version found <a href=\"https://defra.sharepoint.com/:x:/r/teams/Team4068/_layouts/15/Doc.aspx?sourcedoc=%7B3ABC6624-B62B-4AE0-8D6C-A1B065BA3559%7D&amp;file=EU%20Reset%20Delivery%20Programme_Requirements%20Template.xlsx&amp;action=default&amp;mobileredirect=true\" class=\"external-link\" rel=\"nofollow\">here</a>, within EUDP &gt; NNS Exploration <a href=\"https://defra.sharepoint.com/teams/Team4068/Digital%20%20Technology/Forms/AllItems.aspx?id=%2Fteams%2FTeam4068%2FDigital%20%20Technology%2F11%5FProduct%20Working%20Group%2FExplorations%2FPlants%20NNS%20Exploration&amp;viewid=d55c83ca%2De69f%2D484a%2Dbf4f%2D724dbea10b0f&amp;csf=1&amp;CID=56dc0ec8%2Da100%2D46d0%2Da61c%2D3ada9bbf7a9c&amp;FolderCTID=0x012000BE21F7D23E2D3C47BBC04769E8DFD4B2\" class=\"external-link\" rel=\"nofollow\">SharePoint</a>. </p><h1 local-id=\"94743b73f7f1\" id=\"Requirements-NationalNotificationSystem-NotificationDataRequirements(requiredforriskassessing/inspectionplanning)\">Notification Data Requirements (required for risk assessing/inspection planning)</h1><div class=\"confluence-information-macro confluence-information-macro-information conf-macro output-block\" data-hasbody=\"true\" data-macro-name=\"info\" data-macro-id=\"1c845ca9-4d36-4e9b-bb35-68d89962f932\" data-local-id=\"de5eac76a366\"><span class=\"aui-icon aui-icon-small aui-iconfont-info confluence-information-macro-icon\"> </span><div class=\"confluence-information-macro-body\"><p local-id=\"1f5d7d40aeef\">Data to be captured by NNS in relation to commodity type.</p><p local-id=\"a5abd4f4e22f\">True at time of publishing - contact Kate Somerwill-Owens and/or Heather Brittlebank (policy) for an accurate up to date list.</p></div></div><h4 local-id=\"932c2b59e124\" id=\"Requirements-NationalNotificationSystem-Potatoes(seedandware)\">Potatoes (seed and ware)</h4><ul local-id=\"5fd169222653\"><li local-id=\"a7fa31f65aaf\"><p local-id=\"cf50276184e0\">Expected time and date of arrival</p></li><li local-id=\"aa47fb03c205\"><p local-id=\"c3921cd50c44\">Proposed place of landing </p></li><li local-id=\"49225e432ee9\"><p local-id=\"e2444fb45afa\">Country from which the potatoes originate</p></li><li local-id=\"70077e4bc4a0\"><p local-id=\"69f9352b5ec2\">Intended use</p></li><li local-id=\"5e33df24ab5d\"><p local-id=\"8fbcccaad9f3\">Intended destination</p></li><li local-id=\"8ac9902d99a2\"><p local-id=\"abce372ef7f0\">Variety and quantity</p></li><li local-id=\"084c49f288a0\"><p local-id=\"2eb61a75d2cc\">Identification number of the potato produced and crop identification number</p></li></ul><h4 local-id=\"b526e94cc898\" id=\"Requirements-NationalNotificationSystem-Allothergoods\">All other goods</h4><ul local-id=\"d0aa9c4655f7\"><li local-id=\"4c0fc60e-1736-405d-bbcc-d6a3dd0d3c99\"><p local-id=\"cd392a892c5e\">the expected date of landing in GB of the consignment or, if the consignment has arrived in Great Britain, the date on which it first arrived in Great Britain</p></li><li local-id=\"6d1f64b7-7c7c-4a7e-ad94-d9f9870866af\"><p local-id=\"76327d82f5a6\">the intended destination of the consignment, or if the consignment has arrived at its intended destination in Great Britain, its current location</p></li><li local-id=\"9b2e4484-00f9-4e62-8fd1-8445190c8d37\"><p local-id=\"a5a3b8c61451\">the category (e.g. plants for planting or cut wood), genus, species (for plants for planting)</p></li><li local-id=\"2038650c-cb08-4305-9362-3e04681c1bbd\"><p local-id=\"317ec4f93e83\">The Commodity code of the relevant goods,  in the consignment</p></li><li local-id=\"a44051ed-337e-45c9-9786-4e1163d13ba5\"><p local-id=\"f245b87e34e2\">The quantity of the relevant goods, as detailed in paragraph 1, in the consignment</p></li><li local-id=\"b435de7c-be61-43f7-867d-6c481c682408\"><p local-id=\"33e5adc2a018\">the country from which the plants or wood originate</p></li><li local-id=\"2d153d95-8904-4bc8-9661-b032c7c75f8b\"><p local-id=\"e19ddeecf88a\">the name and address of the consignor </p></li><li local-id=\"4282c525-de28-4ee9-a71c-fee80d046c3e\"><p local-id=\"d589605a3c5a\">in the case of plants intended for planting, the identification number of the supplier of the plants and the EPPO code for the plants</p></li><li local-id=\"a8e53f18-0f46-4f10-8c9b-585533261f47\"><p local-id=\"b9f894b36048\">in the case of cut trees or trees for planting, the size of the tree  </p></li><li local-id=\"70c81b84-0002-4384-9c49-e8daccf286da\"><p local-id=\"09e0081d2949\">in the case of wood and wood products (including isolated bark), confirmation of what phytosanitary treatments have been applied</p></li><li local-id=\"83953b29-b4f4-4be8-9341-dddd8050c748\"><p local-id=\"f5550590902c\">Use (optional)</p></li></ul><h4 local-id=\"32d4b98c7b4e\" id=\"Requirements-NationalNotificationSystem-Additionalcaveatsforwoodproducts\">Additional caveats for wood products</h4><ul local-id=\"1af4baed-bb91-4b57-826d-767fff4ebf58\"><li local-id=\"029c375c-debd-4f13-9418-0b7bb3539f58\"><p local-id=\"7452b327a5bf\">Conifer wood with bark and isolated bark of conifer from an EU member state, excluding preservative-treated wood  </p></li><li local-id=\"ee4f9c56-8904-4816-a2a2-680a99b09bef\"><p local-id=\"e791ae67c1a1\">Conifer wood with or without bark and isolated bark from Italy, France, Portugal and Spain, excluding preservative-treated wood  </p></li><li local-id=\"1d7cf0bc-7f82-4c6e-bdc1-04b59051a99b\"><p local-id=\"00d01ad57a82\">Cut coniferous trees &gt; 3 metres in height from an EU member state  </p></li><li local-id=\"cdb2aa95-add0-4a6d-b029-4573a27024c2\"><p local-id=\"b59b4531cc2c\">Wood, of Fraxinus, Castanea, Juglans, Pterocarya and Platanus from an EU member state excluding preservative-treated wood, that:<br/>- retains all or part of its natural round surface, with or without bark <br/>- is in the form of chips which have not undergone processing to produce pellets or briquettes  </p></li></ul>","representation":"view","_expandable":{"webresource":"","embeddedContent":"","mediaToken":"","content":"/rest/api/content/6518997274"}},"_expandable":{"editor":"","atlas_doc_format":"","export_view":"","styled_view":"","markdown":"","dynamic":"","storage":"","editor2":"","anonymous_export_view":""}},"metadata":{"labels":{"results":[],"start":0,"limit":200,"size":0,"_links":{"next":"/rest/api/content/6518997274/label?next=true&limit=200&start=200","self":"https://eaflood.atlassian.net/wiki/rest/api/content/6518997274/label"}},"_expandable":{"lastEditedTime":"","currentuser":"","comments":"","createdBySpaceBlueprint":"","isActiveLiveEditSession":"","sourceTemplateEntityId":"","simple":"","properties":"","frontend":"","likes":""}},"extensions":{"position":233564199},"_expandable":{"childTypes":"","container":"/rest/api/space/EUDP","schedulePublishInfo":"","operations":"","schedulePublishDate":"","children":"/rest/api/content/6518997274/child","restrictions":"/rest/api/content/6518997274/restriction/byOperation","ancestors":"","draftVersion":"","descendants":"/rest/api/content/6518997274/descendant"},"_links":{"editui":"/pages/resumedraft.action?draftId=6518997274","webui":"/spaces/EUDP/pages/6518997274/Requirements+-+National+Notification+System","edituiv2":"/spaces/EUDP/pages/edit-v2/6518997274","context":"/wiki","self":"https://eaflood.atlassian.net/wiki/rest/api/content/6518997274","tinyui":"/x/GgGQhAE","collection":"/rest/api/content","base":"https://eaflood.atlassian.net/wiki"}}
